{
  "$comment": "Repo Governor governing its own repository. Canonical format is JSON (ADR-015). This file is the sole artifact that binds providers to roles (ADR-004); a provider absent here has no governance role, however reachable it is (INV-013).",
  "repo_governor": { "version": 1, "engine_min_version": "0.1.0" },
  "repository": { "id": "tosin2013/repo-governor" },
  "condition": {
    "$comment": "L1: one package, small dependency surface, one maintainer. Not L0 — architecture history exists. No floor indicator present: no public API, no release branches, no generated consumers.",
    "assessed": "L1",
    "profile": "GOVERNOR_LITE"
  },
  "providers": {
    "repository":          { "type": "git",                 "adapter": "adapters/git",                 "contract_version": 1 },
    "roadmap_authority":   { "type": "file-roadmap",         "adapter": "adapters/file-roadmap",        "contract_version": 1 },
    "acceptance_criteria": { "type": "acceptance-file",      "adapter": "adapters/acceptance-file",     "contract_version": 1 },
    "execution":           { "type": "execution-file",       "adapter": "adapters/execution-file",      "contract_version": 1 },
    "architecture":      [ { "type": "adr",                  "adapter": "adapters/adr",                 "contract_version": 1, "path": "docs/adrs" } ],
    "change_signals":    [ { "type": "change-signals-file",  "adapter": "adapters/change-signals-file", "contract_version": 1 } ],
    "retirement":        [ { "type": "retirement-analysis",  "adapter": "adapters/retirement-analysis", "contract_version": 1 } ]
  },
  "permissions": {
    "$comment": "Deny by default (ADR-005). Read-only throughout: Repo Governor rules, it does not act.",
    "repository":          { "read": true, "write": false },
    "roadmap_authority":   { "read": true, "write": false },
    "acceptance_criteria": { "read": true, "write": false },
    "execution":           { "read": true, "write": false },
    "architecture":        { "read": true, "write": false },
    "change_signals":      { "read": true, "write": false },
    "retirement":          { "read": true, "write": false }
  }
}
